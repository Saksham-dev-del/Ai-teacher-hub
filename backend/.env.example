# Server
PORT=3000
NODE_ENV=development
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:3000
MAX_JSON_MB=6

# MongoDB / authentication
MONGODB_URI=mongodb://127.0.0.1:27017/ai_teacher_resource_hub
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_at_least_32_random_characters
AUDIT_HASH_SECRET=replace_with_a_different_long_random_secret
# Optional but recommended before first face enrollment. Keep stable after enrollment.
FACE_IDENTITY_SECRET=replace_with_a_third_different_long_random_secret
JWT_ISSUER=ai-teacher-resource-hub
JWT_AUDIENCE=ai-teacher-web
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
LOGIN_LOCK_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUDIT_RETENTION_DAYS=180

# Gemini generation
AI_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_valid_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# RAG and upload security
RAG_TOP_K=5
MAX_SYLLABUS_PDF_MB=10
MAX_VISUAL_IMAGE_MB=8
DISABLE_RAG_EMBEDDINGS=false

# Detailed Phase 4 generation
PHASE4_SECTION_BATCH_SIZE=4
PHASE4_RAG_TOP_K=10

# Phase 5/6 secure quiz
QUIZ_SUBMISSION_GRACE_SECONDS=5
ATTEMPT_MONITOR_INTERVAL_MS=60000

# Rate limits (per source IP, in-memory; use a shared store when horizontally scaling)
API_RATE_LIMIT=600
LOGIN_RATE_LIMIT=12
REGISTER_RATE_LIMIT=8
AI_RATE_LIMIT=40
EXPORT_RATE_LIMIT=20
UPLOAD_RATE_LIMIT=30
QUIZ_EVENT_RATE_LIMIT=120

# Phase 7 + Phase 8
PHASE78_RATE_LIMIT=80

# Phase 10 multimedia
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
PUBLIC_BASE_URL=http://localhost:3000
PHASE910_RATE_LIMIT=120

# Phase 10 factual verification defaults (optional)
FACTUAL_MAX_CLAIMS=30

# Quiz strict face-presence and identity-match defaults are configured per quiz in the UI.
MAX_IDENTITY_SELFIE_BYTES=350000
