{
  "name": "ai-teacher-resource-hub-backend",
  "version": "12.1.0",
  "private": true,
  "description": "Phase 10 identity-secure platform with clean Motion-powered UI and realistic micro-interactions.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:phase2": "node tests/phase2-smoke.js",
    "test:phase3": "node tests/phase3-smoke.js",
    "test:phase4": "node tests/phase4-smoke.js",
    "test:secure": "node tests/secure-smoke.js",
    "test:phase5": "node tests/phase5-smoke.js",
    "test:phase6": "node tests/phase6-smoke.js",
    "test:security": "npm run test:phase5 && npm run test:phase6",
    "test:phase7": "node tests/phase7-smoke.js",
    "test:phase8": "node tests/phase8-smoke.js",
    "test:phase78": "npm run test:phase7 && npm run test:phase8",
    "test:phase9": "node tests/phase9-smoke.js",
    "test:phase10": "node tests/phase10-smoke.js",
    "test:phase910": "npm run test:phase9 && npm run test:phase10",
    "test:factual-face": "node tests/phase10-factual-face-smoke.js",
    "test:upgrade": "npm run test:phase910 && npm run test:secure && npm run test:factual-face && npm run test:identity && npm run test:ui",
    "test:identity": "node tests/identity-smoke.js",
    "test:ui": "node tests/ui-motion-smoke.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "docx": "^8.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.5.0",
    "mongoose": "^8.5.1",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "unpdf": "^1.6.2"
  }
}
